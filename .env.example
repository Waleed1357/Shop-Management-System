# Copy into .env.local and fill in, then restart `npm run dev`.
# Never put real keys in this file - it is committed to git.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- SMS option 1: TextBee (Android phone sends SMS from its SIM) ----
# API key from https://textbee.dev dashboard. When set, TextBee is used for all SMS.
TEXTBEE_API_KEY=

# ---- SMS option 2: Branded SMS gateway (sender shows the business name) ----
# Used only when TEXTBEE_API_KEY is empty.
# SMS_API_URL: the gateway's "send SMS" link with {to}, {message} and {sender} where those values go, e.g.
#   SMS_API_URL=https://api.gateway.pk/send?key=YOUR_API_KEY&mask={sender}&to={to}&msg={message}
SMS_API_URL=
SMS_SENDER=AWAN ELEC
# Optional: a word the gateway's reply contains when the SMS was accepted (e.g. success)
SMS_SUCCESS_TEXT=
# Number format the gateway wants: intl_no_plus = 923001234567 (default) | intl = +923001234567 | local = 03001234567
SMS_PHONE_FORMAT=intl_no_plus

# If no SMS option is set, the app opens "send from the shop phone" (SMS app / QR code) instead.

# ---- Test endpoint (optional) ----
# A long random secret (16+ characters). Enables POST /api/sms/test to send a fixed test SMS:
#   curl -X POST http://localhost:3000/api/sms/test -H "x-sms-test-token: <token>" -H "Content-Type: application/json" -d '{"to":"03001234567"}'
SMS_TEST_TOKEN=
